@page "/chat"
@using LoRaPTT.Models
@using LoRaPTT.ViewModels
@inject ChatViewModel VM
@implements IDisposable

<div class="d-flex flex-column vh-100 bg-dark text-white">

    <!-- 狀態列 -->
    <div class="p-2 border-bottom border-secondary d-flex align-items-center gap-2">
        <span class="badge @(VM.IsConnected ? "bg-success" : "bg-secondary")">
            @(VM.IsConnected ? "● 已連線" : "○ 未連線")
        </span>
        <small class="text-muted flex-grow-1 text-truncate">@VM.StatusMessage</small>
        @if (!VM.IsConnected)
        {
            <button class="btn btn-sm btn-outline-light" @onclick="Connect">連接</button>
        }
        <button class="btn btn-sm btn-outline-info" @onclick="Ping"
                disabled="@(!VM.IsConnected || VM.IsScanning)">
            @if (VM.IsScanning)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                <text>搜尋中(@(VM.ScanCountdown)s)</text>
            }
            else
            {
                <text>搜尋裝置</text>
            }
        </button>
    </div>

    <!-- 目標與暱稱設定 -->
    <div class="p-2 border-bottom border-secondary d-flex flex-wrap align-items-center gap-2">
        <label class="small text-muted mb-0">目標</label>
        <input class="form-control form-control-sm bg-dark text-white border-secondary"
               style="width:7rem" @bind="VM.TargetHex" placeholder="FFFF" />
        <button class="btn btn-sm btn-outline-secondary" @onclick='() => VM.TargetHex = "FFFF"'>廣播</button>

        <select class="form-select form-select-sm bg-dark text-white border-secondary"
                style="width:auto" @onchange="OnPickTarget">
            <option value="">選擇目標...</option>
            @if (VM.Contacts.Count > 0)
            {
                <optgroup label="聯絡人">
                    @foreach (var c in VM.Contacts)
                    {
                        <option value="@c.IdHex">@c.DisplayName (@c.IdHex)</option>
                    }
                </optgroup>
            }
            @{ var joined = VM.Groups.Where(g => g.Joined).ToList(); }
            @if (joined.Count > 0)
            {
                <optgroup label="群組">
                    @foreach (var g in joined)
                    {
                        <option value="@g.IdHex">@g.DisplayName (@g.IdHex)</option>
                    }
                </optgroup>
            }
        </select>

        <button class="btn btn-sm btn-outline-light ms-auto" @onclick="() => VM.ShowManage = !VM.ShowManage">
            @(VM.ShowManage ? "收合" : "管理")
        </button>
    </div>

    <!-- 管理面板：聯絡人 / 群組 / 暱稱（F-002/F-003/F-020~022）-->
    @if (VM.ShowManage)
    {
        <div class="p-2 border-bottom border-secondary small" style="max-height:40vh; overflow-auto;">
            <div class="d-flex align-items-center gap-2 mb-2">
                <label class="text-muted mb-0">暱稱</label>
                <input class="form-control form-control-sm bg-dark text-white border-secondary"
                       style="width:10rem" @bind="VM.Nickname" />
            </div>

            <div class="text-info">聯絡人</div>
            <div class="d-flex gap-2 mb-1">
                <input class="form-control form-control-sm bg-dark text-white border-secondary"
                       style="width:6rem" placeholder="ID(如A001)" @bind="VM.NewContactId" />
                <input class="form-control form-control-sm bg-dark text-white border-secondary"
                       style="width:8rem" placeholder="暱稱" @bind="VM.NewContactName" />
                <button class="btn btn-sm btn-outline-success" @onclick="AddContact">新增</button>
            </div>
            @foreach (var c in VM.Contacts)
            {
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="flex-grow-1 text-truncate">
                        @c.DisplayName <span class="text-muted">(@c.IdHex)</span>
                        @if (c.Discovered)
                        {
                            <span class="badge bg-info bg-opacity-25 ms-1" style="font-size:0.65rem">探測發現</span>
                        }
                        @if (c.LastRssi.HasValue)
                        {
                            <span class="text-white-50 ms-1" style="font-size:0.65rem">@(c.LastRssi)dBm</span>
                        }
                        @if (c.LastSeen.HasValue)
                        {
                            <span class="text-white-50 ms-1" style="font-size:0.65rem">@FormatLastSeen(c.LastSeen.Value)</span>
                        }
                    </span>
                    <button class="btn btn-sm btn-outline-secondary py-0" @onclick="() => VM.SelectTargetCommand.Execute(c.IdHex)">選為目標</button>
                </div>
            }

            <div class="text-info mt-2">群組</div>
            <div class="d-flex gap-2 mb-1">
                <input class="form-control form-control-sm bg-dark text-white border-secondary"
                       style="width:10rem" placeholder="群組名稱" @bind="VM.NewGroupName" />
                <button class="btn btn-sm btn-outline-success" @onclick="CreateGroup">建立</button>
            </div>
            @foreach (var g in VM.Groups)
            {
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="flex-grow-1 text-truncate">@g.DisplayName <span class="text-muted">(@g.IdHex)</span></span>
                    <button class="btn btn-sm py-0 @(g.Joined ? "btn-success" : "btn-outline-secondary")"
                            @onclick="() => VM.ToggleGroupJoinCommand.Execute(g)">
                        @(g.Joined ? "已加入" : "加入")
                    </button>
                    <button class="btn btn-sm btn-outline-secondary py-0" @onclick="() => VM.SelectTargetCommand.Execute(g.IdHex)">選為目標</button>
                </div>
            }
        </div>
    }

    <!-- 訊息列表 -->
    <div class="flex-grow-1 overflow-auto p-2" id="msg-list">
        @if (VM.Messages.Count == 0)
        {
            <p class="text-muted text-center mt-4">尚無訊息。輸入目標 ID（廣播為 FFFF）後送出。</p>
        }
        @foreach (var m in VM.Messages)
        {
            var outgoing = m.Direction == MessageDirection.Outgoing;
            <div class="d-flex mb-2 @(outgoing ? "justify-content-end" : "justify-content-start")">
                <div class="msg-bubble @(outgoing ? "bg-primary" : "bg-secondary")">
                    @if (!outgoing)
                    {
                        <div class="small text-info">
                            0x@(m.PeerId.ToString("X4"))
                            @if (m.IsGroupOrBroadcast)
                            {
                                <span class="badge bg-dark ms-1">@(Services.Protocol.DstId.IsBroadcast(m.DstId) ? "廣播" : "群組")</span>
                            }
                            @if (m.Rssi.HasValue)
                            {
                                <span class="text-white-50 ms-1">@(m.Rssi)dBm</span>
                            }
                        </div>
                    }
                    <div>@m.Text</div>
                    <div class="small text-white-50 text-end mt-1">
                        @m.Timestamp.ToString("HH:mm")
                        @if (outgoing)
                        {
                            <span class="ms-1">@StatusIcon(m.Status)</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- 輸入列 -->
    <div class="p-2 border-top border-secondary d-flex align-items-center gap-2">
        <input class="form-control bg-dark text-white @(VM.DraftOverLimit ? "border-danger" : "border-secondary")"
               placeholder="輸入訊息..." @bind="VM.DraftText" @bind:event="oninput"
               @onkeydown="OnKeyDown" disabled="@(!VM.IsConnected)" />
        <span class="small @(VM.DraftOverLimit ? "text-danger" : "text-muted")" style="white-space:nowrap">
            @VM.DraftByteCount/@VM.DraftMaxBytes
        </span>
        <button class="btn btn-primary" @onclick="Send"
                disabled="@(!VM.IsConnected || string.IsNullOrWhiteSpace(VM.DraftText) || VM.DraftOverLimit)">
            送出
        </button>
    </div>
</div>

<style>
    .msg-bubble {
        max-width: 78%;
        padding: 6px 10px;
        border-radius: 12px;
        word-break: break-word;
    }
</style>

@code {
    protected override void OnInitialized()
    {
        VM.StateChanged += OnVmChanged;
    }

    private async void OnVmChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async Task Connect() => await VM.ConnectCommand.ExecuteAsync(null);
    private async Task Send()    => await VM.SendCommand.ExecuteAsync(null);
    private async Task Ping()    => await VM.PingCommand.ExecuteAsync(null);
    private void AddContact()    => VM.AddContactCommand.Execute(null);
    private void CreateGroup()   => VM.CreateGroupCommand.Execute(null);

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && VM.IsConnected
            && !string.IsNullOrWhiteSpace(VM.DraftText) && !VM.DraftOverLimit)
            await Send();
    }

    private void OnPickTarget(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        if (!string.IsNullOrEmpty(v)) VM.TargetHex = v;
    }

    private static string StatusIcon(MessageStatus s) => s switch
    {
        MessageStatus.Sending   => "🕓",
        MessageStatus.Delivered => "✓✓",
        MessageStatus.Sent      => "✓",
        MessageStatus.Failed    => "⚠",
        _ => "",
    };

    /// <summary>將 LastSeen 格式化為「X 分鐘前」等友善文字</summary>
    private static string FormatLastSeen(DateTimeOffset lastSeen)
    {
        var ago = DateTimeOffset.Now - lastSeen;
        if (ago.TotalSeconds < 60) return "剛剛";
        if (ago.TotalMinutes < 60) return $"{(int)ago.TotalMinutes}分前";
        if (ago.TotalHours < 24) return $"{(int)ago.TotalHours}時前";
        return lastSeen.ToString("MM/dd");
    }

    public void Dispose()
    {
        VM.StateChanged -= OnVmChanged;
    }
}
