@page "/"
@page "/chat"
@using LoRaPTT.Models
@using LoRaPTT.ViewModels
@inject ChatViewModel VM
@inject IJSRuntime JS
@implements IDisposable

<div class="d-flex flex-column bg-dark text-white" style="height:100%">

    <!-- 頂部狀態列 -->
    <div class="p-2 border-bottom border-secondary d-flex align-items-center gap-2">
        <span class="badge @(VM.IsConnected ? "bg-success" : "bg-secondary")">
            @(VM.IsConnected ? "● 已連線" : "○ 未連線")
        </span>
        <small class="text-muted flex-grow-1 text-truncate">@VM.StatusMessage</small>
        @if (!VM.IsConnected)
        {
            <button class="btn btn-sm btn-outline-light" @onclick="Connect">連接</button>
        }
    </div>

    <!-- 發送目標列（清楚顯示「現在訊息會送給誰」）-->
    <div class="p-2 border-bottom border-secondary">
        <!-- 上排：目前發送目標（醒目）＋ 管理 -->
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="small text-muted">發送至</span>
            <span class="badge @(VM.IsBroadcastTarget ? "bg-warning text-dark" : "bg-info") px-3 py-2 flex-grow-1 text-start text-truncate"
                  style="font-size:0.95rem">
                @(VM.IsBroadcastTarget ? "📡 " : "👤 ")@VM.TargetDisplayName
            </span>
            <button class="btn btn-sm btn-outline-light" @onclick="() => VM.ShowManage = !VM.ShowManage">
                @(VM.ShowManage ? "收合 ▲" : "管理 ▼")
            </button>
        </div>

        <!-- 下排：切換目標的操作鈕 -->
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <!-- 快速切換廣播 -->
            <button class="btn btn-sm @(VM.IsBroadcastTarget ? "btn-warning" : "btn-outline-secondary")"
                    @onclick='() => VM.TargetHex = "FFFF"'>
                📡 廣播
            </button>

            <!-- 從聯絡人/群組選取 -->
            <select class="form-select form-select-sm bg-dark text-white border-secondary"
                    style="width:auto; max-width:11rem" @onchange="OnPickTarget">
                <option value="">選擇對象...</option>
                @if (VM.Contacts.Count > 0)
                {
                    <optgroup label="聯絡人">
                        @foreach (var c in VM.Contacts)
                        {
                            <option value="@c.IdHex">@c.DisplayName (@c.IdHex)</option>
                        }
                    </optgroup>
                }
                @{ var joined = VM.Groups.Where(g => g.Joined).ToList(); }
                @if (joined.Count > 0)
                {
                    <optgroup label="群組">
                        @foreach (var g in joined)
                        {
                            <option value="@g.IdHex">@g.DisplayName (@g.IdHex)</option>
                        }
                    </optgroup>
                }
            </select>

            <!-- 手動輸入 ID -->
            <input class="form-control form-control-sm bg-dark text-white border-secondary"
                   style="width:6rem" @bind="VM.TargetHex" placeholder="ID A001" />
        </div>
    </div>

    <!-- 探測附近裝置（獨立區塊，更醒目）-->
    @if (VM.IsConnected)
    {
        <div class="px-2 py-1 border-bottom border-secondary d-flex align-items-center gap-2 bg-dark bg-opacity-50">
            <button class="btn btn-sm @(VM.IsScanning ? "btn-warning" : "btn-outline-warning")" @onclick="Ping"
                    disabled="@VM.IsScanning">
                @if (VM.IsScanning)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    <text>搜尋中 (@(VM.ScanCountdown)s)...</text>
                }
                else
                {
                    <text>🔍 搜尋附近裝置</text>
                }
            </button>
            <small class="text-muted">
                發送 PING 廣播，附近的 C6L 會自動回覆 ID 與暱稱
                @if (VM.Contacts.Count > 0)
                {
                    <text> · 已知 @VM.Contacts.Count 個裝置</text>
                }
            </small>
        </div>
    }

    <!-- 管理面板：聯絡人 / 群組 / 暱稱（F-002/F-003/F-020~022）-->
    @if (VM.ShowManage)
    {
        <div class="p-2 border-bottom border-secondary small" style="max-height:40vh; overflow-auto;">
            <!-- 暱稱 -->
            <div class="d-flex align-items-center gap-2 mb-2">
                <label class="text-muted mb-0">暱稱</label>
                <input class="form-control form-control-sm bg-dark text-white border-secondary"
                       style="width:10rem" @bind="VM.Nickname" />
                <small class="text-muted">（可在「設定」頁統一管理）</small>
            </div>

            <!-- 聯絡人 -->
            <div class="text-info d-flex align-items-center gap-1">
                聯絡人
                @if (VM.Contacts.Count == 0)
                {
                    <span class="text-muted ms-1">— 尚無。按上方「🔍 搜尋附近裝置」探測，或手動新增 ↓</span>
                }
            </div>

            <!-- 手動新增 -->
            <div class="d-flex gap-2 mb-1 mt-1">
                <input class="form-control form-control-sm bg-dark text-white border-secondary"
                       style="width:6rem" placeholder="ID (如 A001)" @bind="VM.NewContactId" />
                <input class="form-control form-control-sm bg-dark text-white border-secondary"
                       style="width:8rem" placeholder="暱稱" @bind="VM.NewContactName" />
                <button class="btn btn-sm btn-outline-success" @onclick="AddContact">新增</button>
            </div>

            <!-- 聯絡人列表 -->
            @foreach (var c in VM.Contacts)
            {
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="flex-grow-1 text-truncate">
                        @c.DisplayName <span class="text-muted">(@c.IdHex)</span>
                        @if (c.Discovered)
                        {
                            <span class="badge bg-info bg-opacity-25 ms-1" style="font-size:0.65rem">探測發現</span>
                        }
                        @if (c.LastRssi.HasValue)
                        {
                            <span class="text-white-50 ms-1" style="font-size:0.65rem">@(c.LastRssi)dBm</span>
                        }
                        @if (c.LastSeen.HasValue)
                        {
                            <span class="text-white-50 ms-1" style="font-size:0.65rem">@FormatLastSeen(c.LastSeen.Value)</span>
                        }
                    </span>
                    <button class="btn btn-sm btn-outline-primary py-0"
                            @onclick="() => VM.SelectTargetCommand.Execute(c.IdHex)">
                        選為目標
                    </button>
                    <button class="btn btn-sm btn-outline-danger py-0"
                            @onclick="() => VM.RemoveContactCommand.Execute(c)" title="移除聯絡人">
                        ✕
                    </button>
                </div>
            }

            <!-- 群組 -->
            <div class="text-info mt-2">群組</div>
            <div class="d-flex gap-2 mb-1">
                <input class="form-control form-control-sm bg-dark text-white border-secondary"
                       style="width:10rem" placeholder="群組名稱" @bind="VM.NewGroupName" />
                <button class="btn btn-sm btn-outline-success" @onclick="CreateGroup">建立</button>
            </div>
            @foreach (var g in VM.Groups)
            {
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="flex-grow-1 text-truncate">@g.DisplayName <span class="text-muted">(@g.IdHex)</span></span>
                    <button class="btn btn-sm py-0 @(g.Joined ? "btn-success" : "btn-outline-secondary")"
                            @onclick="() => VM.ToggleGroupJoinCommand.Execute(g)">
                        @(g.Joined ? "已加入" : "加入")
                    </button>
                    <button class="btn btn-sm btn-outline-primary py-0"
                            @onclick="() => VM.SelectTargetCommand.Execute(g.IdHex)">
                        選為目標
                    </button>
                </div>
            }
        </div>
    }

    <!-- 探測結果對話框（搜尋附近裝置完成後跳出，讓使用者挑選加入聯絡人）-->
    @if (VM.ShowDiscoveryDialog)
    {
        <div class="discovery-overlay" @onclick="CloseDiscovery">
            <div class="discovery-dialog bg-dark text-white border border-secondary rounded p-3"
                 @onclick:stopPropagation="true">
                <div class="d-flex align-items-center mb-2">
                    <h6 class="mb-0 flex-grow-1">🔍 探測到的裝置（@VM.DiscoveredDevices.Count）</h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseDiscovery"></button>
                </div>
                @if (VM.DiscoveredDevices.Count == 0)
                {
                    <p class="text-muted small mb-0">未發現其他裝置</p>
                }
                else
                {
                    <p class="text-muted small mb-2">挑選要加入聯絡人的裝置：</p>
                    @foreach (var d in VM.DiscoveredDevices)
                    {
                        var known = VM.IsKnownContact(d.DeviceId);
                        <div class="d-flex align-items-center gap-2 mb-2 pb-2 border-bottom border-secondary">
                            <span class="flex-grow-1 text-truncate">
                                @d.DisplayName <span class="text-muted">(@d.IdHex)</span>
                                @if (d.LastRssi.HasValue)
                                {
                                    <span class="text-white-50 ms-1" style="font-size:0.7rem">@(d.LastRssi)dBm</span>
                                }
                            </span>
                            @if (known)
                            {
                                <span class="badge bg-success">已加入</span>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-success py-0" @onclick="() => AddDiscovered(d)">新增</button>
                            }
                        </div>
                    }
                }
                <div class="text-end mt-2">
                    <button class="btn btn-sm btn-outline-light" @onclick="CloseDiscovery">關閉</button>
                </div>
            </div>
        </div>
    }

    <!-- 訊息列表（唯一會捲動的區域；min-height:0 讓它在 flex 直向裡能正確捲動，
         訊息再多也只在此區捲動，不會把下方輸入框推出畫面）-->
    <div class="flex-grow-1 overflow-auto p-2" id="msg-list" style="min-height:0">
        @if (VM.Messages.Count == 0)
        {
            <div class="text-center mt-4">
                <p class="text-muted">尚無訊息</p>
                <div class="small text-muted">
                    <p class="mb-1">💡 使用流程：</p>
                    <p class="mb-1">1. 點「連接」連上 C6L</p>
                    <p class="mb-1">2. 確認發送目標（預設為「📡 廣播」給所有人）</p>
                    <p class="mb-1">3. 輸入文字 → 送出</p>
                    <p class="mb-0 text-white-50">⚠ 對方的 C6L 也需要有 APP 連線才能看到訊息</p>
                </div>
            </div>
        }
        @foreach (var m in VM.Messages)
        {
            var outgoing = m.Direction == MessageDirection.Outgoing;
            <div class="d-flex mb-2 @(outgoing ? "justify-content-end" : "justify-content-start")">
                <div class="msg-bubble @(outgoing ? "bg-primary" : "bg-secondary")">
                    @if (!outgoing)
                    {
                        <div class="small text-info">
                            0x@(m.PeerId.ToString("X4"))
                            @if (m.IsGroupOrBroadcast)
                            {
                                <span class="badge bg-dark ms-1">@(Services.Protocol.DstId.IsBroadcast(m.DstId) ? "廣播" : "群組")</span>
                            }
                            @if (m.Rssi.HasValue)
                            {
                                <span class="text-white-50 ms-1">@(m.Rssi)dBm</span>
                            }
                        </div>
                    }
                    <div>@m.Text</div>
                    <div class="small text-white-50 text-end mt-1">
                        @m.Timestamp.ToString("HH:mm")
                        @if (outgoing)
                        {
                            <span class="ms-1">@StatusIcon(m.Status)</span>
                            @if (m.IsGroupOrBroadcast)
                            {
                                <span class="ms-1 text-white-50" style="font-size:0.65rem">廣播不回 ACK</span>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- 輸入列 -->
    <div class="p-2 border-top border-secondary">
        <!-- 目標提示 -->
        <div class="d-flex align-items-center gap-1 mb-1">
            <small class="@(VM.IsBroadcastTarget ? "text-warning" : "text-info")">
                → @VM.TargetDisplayName
            </small>
            @if (VM.IsBroadcastTarget)
            {
                <small class="text-muted">（所有節點可收到，不回 ACK）</small>
            }
        </div>
        <div class="d-flex align-items-center gap-2">
            <input class="form-control bg-dark text-white @(VM.DraftOverLimit ? "border-danger" : "border-secondary")"
                   placeholder="輸入訊息..." @bind="VM.DraftText" @bind:event="oninput"
                   @onkeydown="OnKeyDown" disabled="@(!VM.IsConnected)" />
            <span class="small @(VM.DraftOverLimit ? "text-danger" : "text-muted")" style="white-space:nowrap">
                @VM.DraftByteCount/@VM.DraftMaxBytes
            </span>
            <button class="btn btn-primary" @onclick="Send"
                    disabled="@(!VM.IsConnected || string.IsNullOrWhiteSpace(VM.DraftText) || VM.DraftOverLimit)">
                送出
            </button>
        </div>
    </div>
</div>

<style>
    .msg-bubble {
        max-width: 78%;
        padding: 6px 10px;
        border-radius: 12px;
        word-break: break-word;
    }

    .discovery-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1050;
    }

    .discovery-dialog {
        width: 90%;
        max-width: 420px;
        max-height: 80vh;
        overflow: auto;
    }
</style>

@code {
    private int _lastMsgCount = -1; // 追蹤訊息數，變多時自動捲到底

    protected override void OnInitialized()
    {
        VM.StateChanged += OnVmChanged;
        // 從 store 同步最新暱稱（修正：在 Settings 頁改了暱稱後切回 Chat 頁不會同步的問題）
        VM.SyncNickname();
    }

    private async void OnVmChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    // 訊息數增加（收到/送出新訊息）時，自動把訊息列捲到最新一則，像 Line
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (VM.Messages.Count != _lastMsgCount)
        {
            _lastMsgCount = VM.Messages.Count;
            try { await JS.InvokeVoidAsync("scrollToBottom", "msg-list"); }
            catch { /* JS 尚未就緒時忽略，下次 render 會再捲 */ }
        }
    }

    private async Task Connect() => await VM.ConnectCommand.ExecuteAsync(null);
    private async Task Send()    => await VM.SendCommand.ExecuteAsync(null);
    private async Task Ping()    => await VM.PingCommand.ExecuteAsync(null);
    private void AddContact()    => VM.AddContactCommand.Execute(null);
    private void CreateGroup()   => VM.CreateGroupCommand.Execute(null);
    private void AddDiscovered(Contact c) => VM.AddDiscoveredCommand.Execute(c);
    private void CloseDiscovery()         => VM.CloseDiscoveryDialogCommand.Execute(null);

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && VM.IsConnected
            && !string.IsNullOrWhiteSpace(VM.DraftText) && !VM.DraftOverLimit)
            await Send();
    }

    private void OnPickTarget(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        // 選回「選擇對象...」(空值) → 視為廣播；否則設為該對象
        VM.TargetHex = string.IsNullOrEmpty(v) ? "FFFF" : v;
    }

    private static string StatusIcon(MessageStatus s) => s switch
    {
        MessageStatus.Sending   => "🕓",
        MessageStatus.Delivered => "✓✓",
        MessageStatus.Sent      => "✓",
        MessageStatus.Failed    => "⚠",
        _ => "",
    };

    /// <summary>將 LastSeen 格式化為「X 分鐘前」等友善文字</summary>
    private static string FormatLastSeen(DateTimeOffset lastSeen)
    {
        var ago = DateTimeOffset.Now - lastSeen;
        if (ago.TotalSeconds < 60) return "剛剛";
        if (ago.TotalMinutes < 60) return $"{(int)ago.TotalMinutes}分前";
        if (ago.TotalHours < 24) return $"{(int)ago.TotalHours}時前";
        return lastSeen.ToString("MM/dd");
    }

    public void Dispose()
    {
        VM.StateChanged -= OnVmChanged;
    }
}
