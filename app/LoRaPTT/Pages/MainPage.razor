@page "/ptt"
@using LoRaPTT.ViewModels
@using LoRaPTT.Models
@inject MainViewModel VM

<div class="container-fluid d-flex flex-column align-items-center justify-content-center vh-100 bg-dark text-white">

    <!-- 狀態列 -->
    <div class="mb-4 text-center">
        <span class="badge @(VM.IsConnected ? "bg-success" : "bg-secondary") fs-6">
            @(VM.IsConnected ? "● 已連線" : "○ 未連線")
        </span>
        @if (!string.IsNullOrEmpty(VM.ModeLabel))
        {
            <span class="badge bg-info ms-2">@VM.ModeLabel</span>
        }
        <p class="mt-2 text-muted small">@VM.StatusMessage</p>
    </div>

    <!-- 發送對象（與文字頁共用同一選擇）-->
    <div class="mb-4 d-flex align-items-center gap-2 flex-wrap justify-content-center">
        <span class="small text-muted">說給</span>
        <span class="badge @(VM.IsBroadcastTarget ? "bg-warning text-dark" : "bg-info") px-3 py-2"
              style="font-size:0.9rem">
            @(VM.IsBroadcastTarget ? "📡 " : "👤 ")@VM.TargetDisplayName
        </span>
        <select class="form-select form-select-sm bg-dark text-white border-secondary"
                style="width:auto; max-width:12rem" @onchange="OnPickTarget">
            <option value="FFFF" selected="@VM.IsBroadcastTarget">📡 廣播（所有人）</option>
            @if (VM.Contacts.Count > 0)
            {
                <optgroup label="聯絡人">
                    @foreach (var c in VM.Contacts)
                    {
                        <option value="@c.IdHex" selected="@(VM.TargetHex == c.IdHex)">@c.DisplayName (@c.IdHex)</option>
                    }
                </optgroup>
            }
            @{ var joined = VM.Groups.Where(g => g.Joined).ToList(); }
            @if (joined.Count > 0)
            {
                <optgroup label="群組">
                    @foreach (var g in joined)
                    {
                        <option value="@g.IdHex" selected="@(VM.TargetHex == g.IdHex)">@g.DisplayName (@g.IdHex)</option>
                    }
                </optgroup>
            }
        </select>
    </div>

    <!-- PTT 大圓按鈕 -->
    <button class="btn-ptt rounded-circle @(VM.IsPttActive ? "active" : "") @(!VM.IsConnected ? "disabled" : "")"
            @onmousedown="OnPttDown"
            @onmouseup="OnPttUp"
            @ontouchstart:preventDefault="true"
            @ontouchstart="OnPttDown"
            @ontouchend="OnPttUp"
            disabled="@(!VM.IsConnected)">
        <span class="ptt-icon">🎙️</span>
        <span class="ptt-label">@(VM.IsPttActive ? "傳送中..." : "按住說話")</span>
    </button>

    <!-- 連線模式選擇 -->
    <div class="mt-5 d-flex gap-3">
        <button class="btn btn-outline-light btn-sm"
                @onclick="VM.ConnectCommand.ExecuteAsync"
                disabled="@VM.IsConnected">
            @(VM.IsConnected ? "已連線" : "連接裝置")
        </button>
    </div>

    <!-- 提示 -->
    <p class="mt-3 text-muted small text-center">
        攜帶模式：USB-C 連接<br/>基站模式：連接 LoRaPTT WiFi
    </p>

</div>

<style>
    .btn-ptt {
        width: 200px;
        height: 200px;
        background: #dc3545;
        border: 4px solid #a71d2a;
        color: white;
        font-size: 1rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        transition: transform 0.1s, background 0.15s;
        user-select: none;
        -webkit-user-select: none;
        cursor: pointer;
        box-shadow: 0 6px 20px rgba(220,53,69,0.4);
    }
    .btn-ptt.active {
        background: #198754;
        border-color: #146c43;
        transform: scale(0.95);
        box-shadow: 0 6px 20px rgba(25,135,84,0.4);
    }
    .btn-ptt.disabled, .btn-ptt:disabled {
        background: #495057;
        border-color: #343a40;
        box-shadow: none;
        cursor: not-allowed;
    }
    .ptt-icon  { font-size: 3rem; }
    .ptt-label { font-size: 0.85rem; margin-top: 6px; letter-spacing: 0.05em; }
</style>

@code {
    private async Task OnPttDown() => await VM.PttPressCommand.ExecuteAsync(null);
    private async Task OnPttUp()   => await VM.PttReleaseCommand.ExecuteAsync(null);

    // 選對象：空值視為廣播（與文字頁共用 VM.TargetHex）
    private void OnPickTarget(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        VM.TargetHex = string.IsNullOrEmpty(v) ? "FFFF" : v;
    }
}
