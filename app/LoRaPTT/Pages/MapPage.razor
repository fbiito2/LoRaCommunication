@page "/map"
@using LoRaPTT.ViewModels
@using LoRaPTT.Models
@using LoRaPTT.Services
@using Microsoft.JSInterop
@using Microsoft.Maui.Devices.Sensors
@using System.Net.Http
@inject NodeRegistry Registry
@inject IMessagingService Messaging
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="map-root">
    <!-- MapLibre 地圖容器 -->
    <div id="lora-map" class="map-canvas"></div>

    <!-- 右上按鈕區（F-037）-->
    <div class="map-tools">
        <button class="map-btn" @onclick="RecenterSelfAsync" title="回到自己"><span class="oi oi-map-marker"></span></button>
        <button class="map-btn" @onclick="ToggleList" title="節點清單"><span class="oi oi-people"></span></button>
        <button class="map-btn" @onclick="ToggleBaseAsync" title="@(_satellite ? "切換街道圖" : "切換衛星圖")"><span class="oi oi-layers"></span></button>
        <button class="map-btn @(_radar ? "active" : "")" @onclick="ToggleRadarAsync" title="氣象雷達"><span class="oi oi-rain"></span></button>
    </div>

    <!-- 右下角資訊浮卡（半透明，直排）：進來顯示自己；點 marker 顯示該節點 -->
    <div class="map-card">
        @if (_card is null)
        {
            <div class="text-muted small">定位中...</div>
        }
        else
        {
            <div class="mc-status @(_card.StatusError ? "text-danger" : "text-success")">@_card.Status</div>
            <div class="mc-name">@_card.Name</div>
            <div class="mc-coords">@_card.Coords</div>
            @if (!string.IsNullOrEmpty(_card.BottomLeft) || !string.IsNullOrEmpty(_card.BottomRight))
            {
                <div class="mc-bottom">
                    <span>@_card.BottomLeft</span>
                    <span>@_card.BottomRight</span>
                </div>
            }
        }
    </div>

    <!-- 節點清單 dialog（地圖頁主清單）-->
    @if (_showList)
    {
        <div class="map-dialog-backdrop" @onclick="ToggleList">
            <div class="map-dialog" @onclick:stopPropagation="true">
                <div class="d-flex align-items-center mb-2">
                    <h6 class="mb-0">節點清單（@Registry.Count）</h6>
                    <button class="btn btn-sm btn-outline-info ms-auto me-2" @onclick="PingAsync">探測</button>
                    <button class="btn-close btn-close-white" @onclick="ToggleList"></button>
                </div>
                @if (Registry.Count == 0)
                {
                    <p class="text-muted small mb-0">尚未聽到任何節點，按「探測」或等待傳訊</p>
                }
                else
                {
                    @foreach (var n in Registry.GetNodes())
                    {
                        <div class="map-node-row" @onclick="() => SelectNode(n)">
                            <span class="fw-bold">0x@n.DeviceIdHex</span>
                            @if (!string.IsNullOrEmpty(n.Name))
                            {
                                <span class="text-info ms-1">@n.Name</span>
                            }
                            <span class="small text-muted ms-2">@NodesViewModel.AgeText(n) · @n.Rssi dBm</span>
                            @if (n.HasPosition)
                            {
                                <span class="small text-success ms-2">📍</span>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

<style>
    /* 版面與 marker 樣式（放頁內 style = 全域，才套得到 JS 動態建立的 marker div）*/
    .map-root { position: relative; width: 100%; height: 100%; background: #20242b; overflow: hidden; }
    .map-canvas { position: absolute; inset: 0; }
    .map-tools { position: absolute; top: 12px; right: 12px; display: flex; flex-direction: column; gap: 8px; z-index: 10; }
    .map-btn { width: 44px; height: 44px; border: none; border-radius: 8px; background: rgba(20,20,25,0.85); color: #fff; font-size: 1.25rem; cursor: pointer; }
    .map-btn:active { background: rgba(60,60,70,0.9); }
    .map-btn.active { background: rgba(13,110,253,0.85); }
    .map-card { position: absolute; right: 12px; bottom: 24px; z-index: 10; background: rgba(15,18,22,0.72); color: #fff; border: 1px solid rgba(255,255,255,0.13); border-radius: 7px; padding: 5px 9px; min-width: 128px; max-width: 60%; backdrop-filter: blur(4px); }
    .mc-status { font-size: 0.6rem; font-weight: 600; letter-spacing: 0.03em; }
    .mc-name { font-size: 0.82rem; font-weight: 700; line-height: 1.2; }
    .mc-coords { font-size: 0.7rem; }
    .mc-bottom { display: flex; justify-content: space-between; gap: 12px; font-size: 0.7rem; color: #ccd6dd; margin-top: 1px; }
    .map-dialog-backdrop { position: absolute; inset: 0; background: rgba(0,0,0,0.55); z-index: 20; display: flex; align-items: flex-start; justify-content: center; padding-top: 10vh; }
    .map-dialog { background: #1a1d22; color: #fff; border: 1px solid #333; border-radius: 10px; padding: 14px; width: 90%; max-width: 420px; max-height: 70vh; overflow: auto; }
    .map-node-row { padding: 8px 6px; border-bottom: 1px solid #2a2d33; cursor: pointer; }
    .lora-self-dot { width: 18px; height: 18px; border-radius: 50%; background: #00e5ff; border: 3px solid #fff; box-shadow: 0 0 8px rgba(0,229,255,0.8); cursor: pointer; }
    .lora-node-dot { width: 16px; height: 16px; border-radius: 50%; background: #ffc107; border: 2px solid #fff; box-shadow: 0 0 6px rgba(0,0,0,0.6); cursor: pointer; }
</style>

@code {
    private DotNetObjectReference<MapPage>? _ref;  // 供 JS 回呼 marker 點選
    private bool _showList;                          // 節點清單 dialog 開關
    private bool _satellite;                         // 底圖是否為衛星(NLSC)
    private bool _radar;                             // CWA 雷達疊加是否開啟
    private CardInfo? _card;                         // 下方浮卡內容
    private double _selfLat, _selfLon;               // 自身座標（手機 GPS）
    private double? _selfAlt, _selfCourse;           // 自身高度（公尺）與方位（度）
    private bool _hasSelf;                           // 是否取得自身定位

    /// <summary>下方浮卡顯示內容（直排：狀態/名稱/座標/底列）</summary>
    private sealed class CardInfo
    {
        public string Status = "";       // 連線狀態（自己）或 RSSI（節點）
        public bool StatusError;         // true → 紅字（未連線）
        public string Name = "";         // 暱稱
        public string Coords = "";       // 經緯度
        public string BottomLeft = "";   // 高度（自己）或最後聽到（節點）
        public string BottomRight = "";  // 方位（自己）
    }

    /// <summary>首次渲染後初始化地圖（容器需先存在）</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _ref = DotNetObjectReference.Create(this);
        await TryGetSelfLocationAsync();
        await JS.InvokeVoidAsync("loraMap.init", _ref,
            _hasSelf ? _selfLat : 0, _hasSelf ? _selfLon : 0, _hasSelf);
        ShowSelfCard();
        await PushNodesAsync();
        Registry.Changed += OnRegistryChanged;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>取得手機 GPS 定位（失敗/無權限則無自身點，地圖用預設中心）</summary>
    private async Task TryGetSelfLocationAsync()
    {
        try
        {
            var loc = await Geolocation.Default.GetLocationAsync(
                new GeolocationRequest(GeolocationAccuracy.Medium, TimeSpan.FromSeconds(8)));
            if (loc != null)
            {
                _selfLat = loc.Latitude; _selfLon = loc.Longitude; _hasSelf = true;
                _selfAlt = loc.Altitude;   // 高度（公尺，可能為 null）
                _selfCourse = loc.Course;  // 方位（度，靜止時可能為 null）
            }
        }
        catch { /* 無定位權限/逾時 → 不顯示自身點 */ }
    }

    /// <summary>浮卡切換為「自己」（連線狀態 / 暱稱 / 座標 / 高度·方位）</summary>
    private void ShowSelfCard()
    {
        var id = Messaging.LocalDeviceId;
        _card = new CardInfo
        {
            Status = id.HasValue ? $"0x{id:X4} 已連線" : "NOT CONNECTED",
            StatusError = !id.HasValue,
            Name = Messaging.LocalNickname,
            Coords = _hasSelf ? $"{_selfLat:F6}, {_selfLon:F6}" : "無 GPS 定位",
            BottomLeft = _selfAlt.HasValue ? $"{_selfAlt.Value:F0} m" : "",
            BottomRight = _selfCourse.HasValue ? $"{_selfCourse.Value:F0}°" : "",
        };
    }

    /// <summary>浮卡切換為某節點（RSSI / 名稱 / 座標 / 最後聽到）</summary>
    private void ShowNodeCard(NodeInfo n)
    {
        _card = new CardInfo
        {
            Status = $"{n.Rssi} dBm",
            StatusError = false,
            Name = string.IsNullOrEmpty(n.Name) ? $"0x{n.DeviceIdHex}" : $"{n.Name}（0x{n.DeviceIdHex}）",
            Coords = n.HasPosition ? $"{n.Lat:F6}, {n.Lon:F6}" : "無座標",
            BottomLeft = NodesViewModel.AgeText(n),
            BottomRight = "",
        };
    }

    /// <summary>把有定位的節點推給地圖更新 markers</summary>
    private async Task PushNodesAsync()
    {
        var nodes = Registry.GetNodes()
            .Where(n => n.HasPosition)
            .Select(n => new { id = n.DeviceIdHex, name = n.Name ?? "", lat = n.Lat, lon = n.Lon })
            .ToArray();
        await JS.InvokeVoidAsync("loraMap.setNodes", new object[] { nodes });
    }

    /// <summary>JS 回呼：點地圖上的節點 marker → 浮卡顯示該節點</summary>
    /// <param name="idHex">節點 ID 的 16 進位字串</param>
    [JSInvokable]
    public async Task OnNodeMarkerClick(string idHex)
    {
        var node = Registry.GetNodes().FirstOrDefault(n => n.DeviceIdHex == idHex);
        if (node != null)
        {
            ShowNodeCard(node);
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>清單中選節點：關 dialog、浮卡顯示、地圖飛到該點</summary>
    private async Task SelectNode(NodeInfo n)
    {
        _showList = false;
        ShowNodeCard(n);
        if (n.HasPosition) { await JS.InvokeVoidAsync("loraMap.flyTo", n.Lat, n.Lon); }
    }

    /// <summary>回到自己：重新定位、地圖飛回、浮卡切回自己</summary>
    private async Task RecenterSelfAsync()
    {
        await TryGetSelfLocationAsync();
        if (_hasSelf)
        {
            await JS.InvokeVoidAsync("loraMap.setSelf", _selfLat, _selfLon);
            await JS.InvokeVoidAsync("loraMap.flyToSelf", _selfLat, _selfLon);
        }
        ShowSelfCard();
    }

    /// <summary>開/關節點清單 dialog</summary>
    private void ToggleList() => _showList = !_showList;

    /// <summary>切換底圖：街道 ↔ 衛星(NLSC 正射影像)</summary>
    private async Task ToggleBaseAsync()
    {
        _satellite = !_satellite;
        await JS.InvokeVoidAsync("loraMap.setBaseLayer", _satellite ? "sat" : "street");
    }

    // 雷達圖檔（S3 公開但無 CORS → 由 .NET 原生 HTTP 抓回轉 data URL 給地圖）
    private static readonly HttpClient _radarHttp = new() { Timeout = TimeSpan.FromSeconds(15) };
    private const string RadarUrl = "https://cwaopendata.s3.ap-northeast-1.amazonaws.com/Observation/O-A0058-005.png";

    /// <summary>開/關 CWA 氣象雷達疊加層。S3 圖檔無 CORS → 由 .NET 抓回轉 data URL 傳給地圖</summary>
    private async Task ToggleRadarAsync()
    {
        _radar = !_radar;
        if (_radar)
        {
            try
            {
                var bytes = await _radarHttp.GetByteArrayAsync(RadarUrl);
                var dataUrl = "data:image/png;base64," + Convert.ToBase64String(bytes);
                await JS.InvokeVoidAsync("loraMap.toggleRadar", true, dataUrl);
            }
            catch (Exception ex)
            {
                _radar = false; // 抓取失敗（多半是當前網路無對外網際網路）→ 回復狀態
                Console.WriteLine("LPTT: 雷達圖抓取失敗: " + ex.Message);
            }
        }
        else
        {
            await JS.InvokeVoidAsync("loraMap.toggleRadar", false, (string?)null);
        }
    }

    /// <summary>廣播 PING 主動探測</summary>
    private async Task PingAsync()
    {
        try { await Messaging.SendPingAsync(); }
        catch { /* 探測失敗不阻斷 UI */ }
    }

    /// <summary>NodeDB 變動 → 更新地圖 markers 與清單</summary>
    private async void OnRegistryChanged()
        => await InvokeAsync(async () => { await PushNodesAsync(); StateHasChanged(); });

    /// <summary>離開頁面：取消訂閱、釋放地圖、釋放 .NET 參考</summary>
    public async ValueTask DisposeAsync()
    {
        Registry.Changed -= OnRegistryChanged;
        try { await JS.InvokeVoidAsync("loraMap.dispose"); }
        catch { /* WebView 可能已釋放 */ }
        _ref?.Dispose();
    }
}
