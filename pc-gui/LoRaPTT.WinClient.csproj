<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LoRaPTT.WinClient</RootNamespace>
    <AssemblyName>LoRaPTT.WinClient</AssemblyName>
  </PropertyGroup>

  <!-- 重用 MAUI App 的協定碼（link，不複製），確保位元級一致 -->
  <ItemGroup>
    <Compile Include="..\app\LoRaPTT\Services\Protocol\*.cs" Link="Protocol\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
